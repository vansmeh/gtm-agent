{
  "name": "redis-gtm-agent",
  "user": "ubuntu",
  "install": "bash scripts/install.sh",
  "start": "bash scripts/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 }
  ]
}
